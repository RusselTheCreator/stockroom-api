# Server Configuration
PORT=3100
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://stockroom:stockroom_secret@localhost:5432/stockroom

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h

# AI Provider Configuration
# Options: openai | anthropic | bedrock | mock
AI_PROVIDER=mock

# OpenAI Configuration (when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Configuration (when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# AWS Bedrock Configuration (when AI_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Test Configuration (for running tests)
TEST_DATABASE_URL=postgresql://stockroom:stockroom_secret@localhost:5432/stockroom_test
